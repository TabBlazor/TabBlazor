@page "/docs/confetti"

<Page>
    <DocsExample Title="Confetti" ComponentType="typeof(Confetti)">
        <CodeSnippet Component="@typeof(ConfettiBasic)" Title="Basic">
            <Description>Wrap any clickable content. A click pours a short shower of confetti over the page.</Description>
        </CodeSnippet>
        <CodeSnippet Component="@typeof(ConfettiAmount)" Title="Amount and duration"/>
        <CodeSnippet Component="@typeof(ConfettiColors)" Title="Colors"/>
        <CodeSnippet Component="@typeof(ConfettiSpeed)" Title="Speed"/>
        <CodeSnippet Component="@typeof(ConfettiService)" Title="From code">
            <Description>Burst from any handler through TablerService, for example after a save completes.</Description>
        </CodeSnippet>
        <CodeSnippet Component="@typeof(ConfettiEvents)" Title="Events"/>
    </DocsExample>
</Page>
