<section class="mb-5">
    <h4 class="h2 mb-2" id="@Id">@Title</h4>

    @if (Description != null)
    {
        <div class="mb-3">@Description</div>
    }

    @if (ShowExample)
    {
        <div class="mb-3 @ExampleBackground()">
            @if (Component != null)
            {
                <DynamicComponent Type="Component"/>
            }
        </div>
    }

    <div class="card-code">
        <figure class="highlight markdown">
            @((MarkupString)@Code)
        </figure>
    </div>
</section>
