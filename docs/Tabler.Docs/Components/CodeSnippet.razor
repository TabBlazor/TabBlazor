<section class="mb-5">
    <h4 class="h2 mb-2 docs-heading" id="@Anchor">
        @Title
        <a class="docs-anchor" href="@AnchorHref" title="Link to this example" aria-label="@($"Link to {Title}")"
           @onclick="@(() => DocsExample.ScrollToAnchor(Anchor))" @onclick:preventDefault="false">#</a>
    </h4>

    @if (Description != null)
    {
        <div class="mb-3">@Description</div>
    }

    @if (ShowExample)
    {
        <div class="mb-3 @ExampleBackground()">
            @if (Component != null)
            {
                <DynamicComponent Type="Component"/>
            }
        </div>
    }

    <div class="card-code">
        <figure class="highlight markdown">
            @((MarkupString)@Code)
        </figure>
    </div>
</section>
