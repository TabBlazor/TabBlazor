@page "/docs/signals"

<Page>
    <DocsExample Title="Signal" ComponentType="typeof(Signal)">
        <CodeSnippet Component="@typeof(SignalsBasic)" Title="Basic">
            <Description>A small row of stepped bars showing a level. Set the number of lit bars with Level.</Description>
        </CodeSnippet>
        <CodeSnippet Component="@typeof(SignalsWithLabel)" Title="With label">
            <Description>Set Label to an empty string when adjacent text already describes the level.</Description>
        </CodeSnippet>
        <CodeSnippet Component="@typeof(SignalsColors)" Title="Colors"/>
        <CodeSnippet Component="@typeof(SignalsBars)" Title="Number of bars">
            <Description>Between two and five bars.</Description>
        </CodeSnippet>
        <CodeSnippet Component="@typeof(SignalsSize)" Title="Size"/>
    </DocsExample>
</Page>
