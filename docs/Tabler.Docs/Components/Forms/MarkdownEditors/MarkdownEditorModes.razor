<MarkdownEditor @bind-Value="text" @bind-Mode="mode" aria-label="Release notes" />

<div class="mt-2 text-secondary small">Mode: @mode</div>

@code {
    private MarkdownEditorMode mode = MarkdownEditorMode.Split;

    private string text = """
        ## Release 2.4

        - [x] Faster search
        - [ ] Dark mode for reports

        | Area    | Change         |
        |---------|----------------|
        | Orders  | ~~Old~~ New UI |

        See the [changelog](https://tabblazor.com) for details.
        """;
}
