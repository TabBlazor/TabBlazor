<RichTextEditor @bind-Value="json" Format="RichTextEditorFormat.Json" aria-label="Notes" />

<div class="row g-3 mt-0">
    <div class="col-md-6">
        <div class="form-label">Value</div>
        <pre class="mb-0 text-wrap" style="max-height: 12rem">@(json ?? "null")</pre>
    </div>
    <div class="col-md-6">
        <div class="form-label">RichTextJson.ToHtml(json)</div>
        <pre class="mb-3 text-wrap" style="max-height: 6rem">@RichTextJson.ToHtml(json)</pre>
        <div class="form-label">&lt;RichTextView Json="@@json" /&gt;</div>
        <div class="card card-body">
            <RichTextView Json="@json" />
        </div>
    </div>
</div>

@code {
    private string json = """{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Stored as "},{"type":"text","marks":[{"type":"bold"}],"text":"JSON"},{"type":"text","text":"."}]}]}""";
}
