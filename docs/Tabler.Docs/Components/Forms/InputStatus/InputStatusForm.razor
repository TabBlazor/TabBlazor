@using System.ComponentModel.DataAnnotations

<TablerForm Model="model">
    <div class="mb-3" style="max-width: 320px">
        <label class="form-label">Name</label>
        <InputStatus Value="model.Name" Save="SaveAsync" For="() => model.Name">
            <InputText class="form-control" @bind-Value="model.Name" />
        </InputStatus>
        <TabValidationMessage For="() => model.Name" />
    </div>
    <div class="mb-3" style="max-width: 320px">
        <label class="form-label">Age</label>
        <InputStatus Value="model.Age" Save="SaveAsync" For="() => model.Age">
            <InputNumber class="form-control" @bind-Value="model.Age" />
        </InputStatus>
        <TabValidationMessage For="() => model.Age" />
    </div>
</TablerForm>

@code {
    Person model = new() { Name = "Tabler", Age = 30 };

    Task SaveAsync() => Task.Delay(1000);

    class Person
    {
        [Required]
        [StringLength(10)]
        public string Name { get; set; }

        [Range(0, 120)]
        public int Age { get; set; }
    }
}
