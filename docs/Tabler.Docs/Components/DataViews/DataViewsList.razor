<DataView Items="DataViewDemoData.Orders" Title="Orders" KeySelector="o => o.Id" PageSize="8"
          Views="DataViewKind.Table | DataViewKind.List" @bind-View="view">
    <DataColumn Value="o => o.OrderNo" Title="Order" Sortable Searchable />
    <DataColumn Title="Name" Id="name" Value="@(o => $"{o.FirstName} {o.LastName}")" Sortable Searchable />
    <DataColumn Value="o => o.Customer.Name" Title="Customer" Searchable />
    <DataColumn Value="o => o.OrderDate" Title="Date" Format="yyyy-MM-dd" Sortable DefaultSort="SortOrder.Descending" />

    <ListItemTemplate>
        <DataListItem>
            <Avatar><span class="avatar avatar-sm">@context.FirstName[0]@context.LastName[0]</span></Avatar>
            <Title>@context.FirstName @context.LastName</Title>
            <Subtitle>@context.OrderNo · @context.Customer.Name</Subtitle>
            <Meta>@context.OrderDate.ToString("d")</Meta>
        </DataListItem>
    </ListItemTemplate>
</DataView>

@code {
    private DataViewKind? view = DataViewKind.List;
}
