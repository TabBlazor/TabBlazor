@using Align = TabBlazor.Align
<DataView Items="DataViewDemoData.Orders" Title="Orders" KeySelector="o => o.Id" PageSize="10" Hover ResizableColumns>
    <DataColumn Value="o => o.OrderNo" Title="Order" Sortable Searchable />
    <DataColumn Value="o => o.Customer.Name" Title="Customer" Sortable Searchable />
    <DataColumn Value="o => o.Status" Sortable Searchable />
    <DataColumn Value="o => o.OrderDate" Title="Date" Format="yyyy-MM-dd" Sortable DefaultSort="SortOrder.Descending" />
    <DataColumn Value="o => o.Total" Format="N2" Align="Align.End" Sortable Searchable />
</DataView>
