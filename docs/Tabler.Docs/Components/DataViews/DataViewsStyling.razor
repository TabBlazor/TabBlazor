@using Align = TabBlazor.Align
<DataView Items="DataViewDemoData.Orders" Title="Orders" KeySelector="o => o.Id" PageSize="25"
          RowHref="@(o => $"docs/data-views?order={o.Id}")"
          RowColor="@(o => o.IsOverdue ? TablerColor.Danger : null)"
          RowClass="@(o => o.Status == DemoOrderStatus.Cancelled ? "text-secondary" : null)"
          Striped StickyHeader Height="420px">
    <DataColumn Value="o => o.OrderNo" Title="Order" NoWrap Sortable Searchable />
    <DataColumn Value="o => o.Status" Sortable>
        <Template>
            <span class="badge @(context.IsOverdue ? "bg-red-lt" : "bg-secondary-lt")">
                @EnumDisplay.GetName(context.Status)@(context.IsOverdue ? " · overdue" : "")
            </span>
        </Template>
    </DataColumn>
    <DataColumn Value="o => o.Comment" Truncate Width="240px" />
    <DataColumn Value="o => o.Total" Format="N2" Align="Align.End" Sortable
                CellColor="@(o => o.Total > 1500 ? TablerColor.Green : null)"
                CellClass="@(o => o.Total > 1500 ? "fw-bold" : null)" />
</DataView>
