<Row>
    <RowCol Md="6" Lg="3">
        <Card Gradient="TablerColor.Primary">
            <CardBody>
                <h3 class="card-title">Primary</h3>
                Gradient fades in from the top by default.
            </CardBody>
        </Card>
    </RowCol>
    <RowCol Md="6" Lg="3">
        <Card Gradient="TablerColor.Green" GradientDirection="CardGradientDirection.Start">
            <CardBody>
                <h3 class="card-title">Green, start</h3>
                Gradient fades in from the start edge.
            </CardBody>
        </Card>
    </RowCol>
    <RowCol Md="6" Lg="3">
        <Card Gradient="TablerColor.Orange" GradientDirection="CardGradientDirection.End">
            <CardBody>
                <h3 class="card-title">Orange, end</h3>
                Gradient fades in from the end edge.
            </CardBody>
        </Card>
    </RowCol>
    <RowCol Md="6" Lg="3">
        <Card Gradient="TablerColor.Purple" GradientDirection="CardGradientDirection.Bottom" GradientAnimated>
            <CardBody>
                <h3 class="card-title">Purple, bottom, animated</h3>
                Gradient fades in from the bottom and animates.
            </CardBody>
        </Card>
    </RowCol>
</Row>
