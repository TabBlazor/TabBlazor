@page "/docs/tabs"
    <Page>
        <DocsExample Title="Tabs" ComponentType="typeof(Tabs)">

            <CodeSnippet Component="@typeof(TabsBasic)" Title="Basic Setup">
                <Description>
                    Basic tabs setup
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsHeader)" Title="Header">
                <Description>
                    Use Header template to set tab header
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsIcons)" Title="Icons and badges">
                <Description>
                    Set <code>Icon</code> on a tab to show an icon before its title, and <code>Badge</code> (with an optional <code>BadgeColor</code>) to show a count after it.
                    On small screens the tab headers stay on one row that scrolls sideways instead of wrapping.
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsBottomBar)" Title="Bottom bar on mobile" ShowExample="false">
                <Description>
                    Set <code>MobilePlacement="TabsMobilePlacement.Bottom"</code> to pin the tab headers to the bottom of the screen on small screens, within thumb reach.
                    Each tab shows its <code>Icon</code> above its title with its <code>Badge</code> on the icon, the bar scrolls sideways when the tabs don't fit, and it hides while an input inside the tabs has focus.
                    Use it for one Tabs that fills the page, not for several Tabs on one page.
                    <a href="docs/tabs/bottom-bar">Open the demo page</a> on a phone or in a narrow window.
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsPreload)" Title="Preload on hover">
                <Description>
                    Set <code>Preload="TabPreload.Hover"</code> to start rendering a tab's content hidden as soon as its header is hovered, focused or pressed, so it is ready when clicked.
                    Use <code>PreloadDelay</code> to require the pointer to rest before preloading, <code>KeepAlive</code> to keep visited tabs rendered,
                    and <code>OnActivated</code> or the <code>IsActiveTab</code> cascading value to react when preloaded content becomes visible (e.g. redraw a chart).
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsChartRedraw)" Title="Redraw preloaded content">
                <Description>
                    Content preloaded while hidden has no size. Use <code>OnActivated</code> to redraw it once the tab is shown.
                    Content components can instead read <code>[CascadingParameter(Name = "IsActiveTab")] bool IsActiveTab</code>.
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsDeepLink)" Title="Deep linking">
                <Description>
                    Set <code>UrlParameter</code> to store the selected tab in the query string, so a URL like <code>?demo-tab=orders</code> opens that tab and tab headers become real links.
                    Tabs are identified by <code>Id</code>, or by their 1-based position when no Id is set. Use <code>Id</code> for tabs that are conditional, data-driven or may be reordered, since positions shift.
                    Selecting a tab replaces the current history entry; set <code>UrlHistory="TabUrlHistory.Push"</code> to add one per tab instead.
                </Description>
            </CodeSnippet>

            <CodeSnippet Component="@typeof(TabsKeepAlive)" Title="Keep alive">
                <Description>
                    By default a tab's content is discarded when another tab is activated. Set <code>KeepAlive="true"</code> to keep visited tabs rendered,
                    preserving their state (input, scroll position, loaded data) when switching back.
                </Description>
            </CodeSnippet>
        </DocsExample>

    </Page>
