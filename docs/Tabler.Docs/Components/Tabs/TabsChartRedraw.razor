<Tabs Preload="TabPreload.Hover">
    <Tab Title="Summary">
        <h3>Summary</h3>
        <p class="text-secondary">Hover the chart tab to render it in the background.</p>
    </Tab>
    <Tab Title="Net value chart" OnActivated="RedrawChart">
        <ApexChart @ref="chart" TItem="Order" XAxisType="XAxisType.Category" Height="300">
            <ApexPointSeries TItem="Order"
                             Items="SampleData.GetOrders()"
                             SeriesType="SeriesType.Bar"
                             Name="Net Value"
                             XValue="@(e => e.OrderType)"
                             YAggregate="@(e => e.Sum(e => e.NetValue))"
                             OrderBy="e => e.X" />
        </ApexChart>
    </Tab>
</Tabs>

@code {
    private ApexChart<Order> chart;

    private async Task RedrawChart()
    {
        if (chart != null)
        {
            await chart.RenderAsync();
        }
    }
}
