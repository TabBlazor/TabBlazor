@namespace TabBlazor
@inherits TablerBaseComponent
@implements IDisposable

<div class="@ClassNames"
     aria-busy="@(currentState == InputSaveState.Saving ? "true" : null)"
     @attributes="UnmatchedParameters">
    @ChildContent
    <span class="visually-hidden" role="status">@AnnouncedText</span>
    @if (currentState == InputSaveState.Saving)
    {
        <span class="input-status-addon" aria-hidden="true">
            <span class="spinner-border spinner-border-sm text-secondary"></span>
        </span>
    }
    else if (currentState == InputSaveState.Saved)
    {
        <span class="input-status-addon text-success" aria-hidden="true">
            <Icon IconType="@InternalIcons.Check" Size="18" />
        </span>
        <span class="input-status-bubble input-status-bubble-saved" aria-hidden="true" style="@SavedDurationStyle">@SavedText</span>
    }
    else if (currentState == InputSaveState.Error)
    {
        @if (CanRetry)
        {
            <button type="button" class="input-status-addon input-status-retry text-danger" title="@RetryText" aria-label="@RetryText" @onclick="RetryAsync">
                <Icon IconType="@InternalIcons.Alert_triangle" Size="18" />
            </button>
        }
        else
        {
            <span class="input-status-addon text-danger" aria-hidden="true">
                <Icon IconType="@InternalIcons.Alert_triangle" Size="18" />
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <span class="input-status-bubble input-status-bubble-error" aria-hidden="true">@ErrorText</span>
        }
    }
</div>
