@namespace TabBlazor
@inherits TablerBaseComponent


<li class="nav-item">
    <a href="@Href" @onclick=Activate @onclick:preventDefault="PreventClickNavigation" @onkeydown=ActivateOnEnter tabindex="@TabIndex" class="nav-link cursor-pointer @TitleCssClass" data-toggle="tab" @attributes="PreloadHandlers">
        @if (Icon != null)
        {
            <Icon IconType="Icon" class="icon nav-link-icon" />
            <span class="nav-link-title">@TitleContent</span>
        }
        else
        {
            @TitleContent
        }
    </a>
</li>
