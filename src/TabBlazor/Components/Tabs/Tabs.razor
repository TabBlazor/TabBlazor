@namespace TabBlazor
@inherits TablerBaseComponent

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Sections


<div class="@ClassNames">
    <CascadingValue Value="@this">
        <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" data-toggle="tabs">
            @ChildContent
        </ul>
</div>
    </CascadingValue>

    @if (IsBottomBar)
    {
        <div class="tabs-mobile-title">
            <h3 class="card-title"><SectionOutlet SectionId="MobileTitleSection" /></h3>
        </div>
    }

    <div class="card-body">
        <div class="tab-content">
            @foreach (var tab in tabs.Where(renderedTabs.Contains))
            {
                var isActive = tab == ActiveTab;
                <div @key="tab" class="tab-pane @(isActive ? "active show" : null)">
                    <CascadingValue Name="IsActiveTab" Value="isActive">
                        <div>@tab.ChildContent</div>
                    </CascadingValue>
                </div>
            }
        </div>
    </div>
</div>
