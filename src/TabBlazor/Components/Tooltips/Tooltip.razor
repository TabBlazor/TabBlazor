@namespace TabBlazor
@using TabBlazor.Services
@inherits TablerBaseComponent
@implements IAsyncDisposable
@inject IServiceProvider ServiceProvider

<div class="tooltip-wrapper @(UsePopper ? "popper" : null)"
     @ref="referenceEl"
     @onmouseover="@OnMouseOverAsync"
     @onmouseout="@OnMouseOutAsync">
    <div class="tooltip-content" @ref="popperEl" role="tooltip">
        @if (TooltipTemplate != null)
        {
            @TooltipTemplate
        }
        else
        {
            @Text
        }
    </div>
    @ChildContent
</div>
