@typeparam TableItem
@inherits EditRowBase<TableItem>

@namespace  TabBlazor.Components.Tables

<tr class="is-inline-edit data-row @(InlineEditTable.ShowSavingDimmer && InlineEditTable.IsSaving ? "is-saving" : null)" @ref="editRow">

    @if (InlineEditTable.ShowCheckboxes)
    {
        <td></td>
    }

    @foreach (var column in InlineEditTable.VisibleColumns)
    {
        <td style="@GetColumnWidth(column)" class="@GetColumnClass(column)" data-label="@column.Title">
            @if (column.EditorTemplate != null)
            {
                @column.EditorTemplate(Item)
            }
            else if (column.Template != null)
            {
                @column.Template(Item)
            }
            else
            {
                @column.GetValue(Item)
            }
        </td>
    }

    @if (!InlineEditTable.HasActionColumn)
    {
        <td>
            <div class="row-action-edit">
                <button class="btn btn-primary btn-sm" @onclick:stopPropagation type="submit" disabled="@(!InlineEditTable.IsRowValid || InlineEditTable.IsSaving)">
                    @if (InlineEditTable.IsSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Save
                </button>
                <button class="btn btn-secondary btn-sm" @onclick:stopPropagation type="button" @onclick="OnEditItemCanceled" disabled="@InlineEditTable.IsSaving">Cancel</button>
            </div>
        </td>

    }
</tr>