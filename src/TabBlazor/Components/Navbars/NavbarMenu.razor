@inherits TablerBaseComponent
@namespace TabBlazor

<HtmlElement Tag="@HtmlTag"
             class="@ClassNames"
             @onclick="OnClick"
             @attributes="@UnmatchedParameters">

    <ClickOutside Active="Navbar.IsFoldedNavbar" OnClickOutside="Navbar.CloseAll">
        <ul class="navbar-nav" @onclick="@Navbar.ToggleExpand">
            @ChildContent
        </ul>
    </ClickOutside>

</HtmlElement>