@inherits TablerBaseComponent
@namespace TabBlazor

<CascadingValue Name="Navbar" Value=this>
    <HtmlElement Tag="@HtmlTag"
                 class="@ClassNames"
                 @onclick="OnClick"
                 @onmouseleave="OnMouseLeave"
                 @attributes="@UnmatchedParameters" data-bs-theme="@Theme">

        <div class="container-fluid">

            <button class="navbar-toggler" type="button" @onclick="ToggleExpand">
                <span class="navbar-toggler-icon"></span>
            </button>
                @ChildContent
            @if (Footer != null)
            {
                <div class="navbar-footer">
                    @Footer
                </div>
            }
        </div>
    </HtmlElement>
</CascadingValue>