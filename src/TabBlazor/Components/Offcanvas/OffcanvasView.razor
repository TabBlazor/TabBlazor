@namespace TabBlazor

<ClickOutside OnClickOutside="OnClickOutside" Active="clickOutsideActive">
    <div class="@ClassNames" style="z-index: @zIndex" @ref="panel" @onkeydown="OnKeyDown" tabindex="-1" aria-labelledby="@titleId" aria-modal="true" role="dialog">
        <div class="offcanvas-header" @onclick:stopPropagation>
            <h2 class="offcanvas-title" id="@titleId">@Title</h2>
            <button type="button" class="btn-close text-reset" aria-label="Close" @onclick="Close"/>
        </div>
        <div class="offcanvas-body">
            @ChildContent
        </div>
    </div>
</ClickOutside>

@if (Options.Backdrop)
{
    <div class="offcanvas-backdrop fade show" style="z-index: @(zIndex - 1)"/>
}
