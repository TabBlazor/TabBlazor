@namespace TabBlazor
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web

@{
    var freeze = View.FreezePlan;
    var columns = View.VisibleColumns;
    var columnCount = columns.Count + (View.ShowCheckboxes ? 1 : 0) + (View.ShowExpandColumn ? 1 : 0) + (View.ShowActionsColumn ? 1 : 0);
}
<CascadingValue Value="Session.EditContext" IsFixed="false">
    @if (View.ValidatorComponent != null)
    {
        <DynamicComponent Type="View.ValidatorComponent" @ref="validator" />
    }
    <tr class="dv-edit-row @(Session.IsSaving ? "dv-saving" : null)" @onkeydown="OnKeyDownAsync" @onkeyup="OnKeyUpAsync" aria-busy="@(Session.IsSaving ? "true" : null)">
        @if (View.ShowCheckboxes)
        {
            <td class="@freeze.Select.AddClass("w-1")" style="@freeze.Select.Style"></td>
        }
        @if (View.ShowExpandColumn)
        {
            <td class="@freeze.Expand.AddClass("w-1")" style="@freeze.Expand.Style"></td>
        }
        @if (View.ShowActionsColumn && View.RowActionsPosition == RowActionsPosition.Start)
        {
            <td class="@freeze.StartActions.AddClass("w-1 text-nowrap")" style="@freeze.StartActions.Style"><DataRowActions TItem="TItem" Item="ActionItem" View="View" /></td>
        }
        @for (var index = 0; index < columns.Count; index++)
        {
            var column = columns[index];
            var cellFreeze = freeze.Column(index);
            <td class="@cellFreeze.AddClass(column.GetCellClass(Session.Draft))" style="@cellFreeze.Style" data-label="@column.Title">
                @if (column.CanEdit(Session.Draft))
                {
                    @column.Editor(Session.Draft)
                    @column.ValidationMessage(Session.Draft)
                }
                else
                {
                    @column.GetDisplayText(Session.Draft)
                }
            </td>
        }
        @if (View.ShowActionsColumn && View.RowActionsPosition == RowActionsPosition.End)
        {
            <td class="@freeze.EndActions.AddClass("w-1 text-nowrap")" style="@freeze.EndActions.Style"><DataRowActions TItem="TItem" Item="ActionItem" View="View" /></td>
        }
    </tr>
    @if (Session.Message != null)
    {
        <tr class="dv-edit-message">
            <td colspan="@columnCount">
                <div class="alert alert-danger m-0" role="alert">@Session.Message</div>
            </td>
        </tr>
    }
</CascadingValue>

@code {
    private DynamicComponent validator;
    private bool enterPressed;

    [Parameter, EditorRequired] public DataView<TItem> View { get; set; } = default!;
    [Parameter, EditorRequired] public DataEditContext<TItem> Session { get; set; } = default!;

    // Row actions show Save and Cancel for the row being edited; a new item uses its draft.
    private TItem ActionItem => Session.IsNew ? Session.Draft : Session.Original!;

    protected override void OnAfterRender(bool firstRender)
    {
        Session.ValidatorInstance = validator?.Instance;
    }

    // Enter saves on keyup: the focused input's change event (sent after keydown) has updated the draft by then.
    // Only a keyup that follows a keydown in this row counts, not the end of the Enter that started the edit.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            enterPressed = true;
        }
        else if (e.Key == "Escape")
        {
            await View.CancelEditAsync(force: false);
        }
    }

    private async Task OnKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && enterPressed)
        {
            enterPressed = false;
            await View.SaveEditAsync(Session);
        }
    }
}
