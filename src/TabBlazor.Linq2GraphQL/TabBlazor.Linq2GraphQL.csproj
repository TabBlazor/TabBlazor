<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Linq2GraphQL adapter for TabBlazor DataView: sorts, searches, filters and pages HotChocolate GraphQL APIs through generated Linq2GraphQL clients.</Description>
        <Authors>Joakim Dangården</Authors>
        <Product>TabBlazor</Product>
        <PackageTags>Blazor Tabler DataView GraphQL Linq2GraphQL HotChocolate</PackageTags>
        <RepositoryUrl>https://github.com/TabBlazor/TabBlazor</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://tabblazor.com/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>TabBlazorLogo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\TabBlazor\TabBlazorLogo.png" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Linq2GraphQL.Client" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TabBlazor\TabBlazor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TabBlazor.Linq2GraphQL.Tests" />
    </ItemGroup>
</Project>
